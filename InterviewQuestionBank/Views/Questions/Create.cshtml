@model Question
@{
    ViewBag.Title = "Add Interview Question";
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">➕ Add Interview Question</h2>

    <form method="post" class="bg-light p-4 rounded shadow-sm">
        <div class="mb-3">
            <label class="form-label">Question</label>
            <textarea name="QuestionText" class="form-control" required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Answer</label>
            <textarea name="Answer" class="form-control" rows="3" required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Difficulty</label>
            <select name="Difficulty" class="form-select">
                <option>Easy</option>
                <option>Medium</option>
                <option>Hard</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="CategoryId" class="form-select">
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>

        <button class="btn btn-primary">Save Question</button>
        <a href="/Questions" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div>
